{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anti-churn-audit/schemas/remediation-manifest.schema.json",
  "title": "AntiChurnRemediationManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "repo", "sha", "items"],
  "definitions": {
    "automation": {
      "type": "string",
      "enum": [
        "AUTO_SAFE",
        "AUTO_WITH_APPROVAL",
        "MANUAL_EXTERNAL",
        "MANUAL_CODE",
        "DATA_DEPENDENT",
        "STRATEGY_HUMAN",
        "NOT_APPLICABLE"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "INFO"]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "title",
        "why_it_matters",
        "status",
        "severity",
        "confidence",
        "automation",
        "estimated_effort",
        "owner"
      ],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
        "title": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": { "type": "string" },
              "line_start": { "type": "integer" },
              "line_end": { "type": "integer" }
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "PARTIAL",
            "ABSENT",
            "EXTERNAL_UNKNOWN",
            "NOT_APPLICABLE",
            "DATA_REQUIRED",
            "CONTEXT_REQUIRED",
            "STRATEGY_REQUIRED",
            "BLOCKED"
          ]
        },
        "severity": { "$ref": "#/definitions/severity" },
        "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "automation": { "$ref": "#/definitions/automation" },
        "prerequisites": {
          "type": "array",
          "items": { "type": "string" }
        },
        "proposed_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "external_steps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tests_required": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rollback": { "type": "string" },
        "expected_result": { "type": "string" },
        "success_metric": { "type": "string" },
        "owner": {
          "type": "string",
          "enum": ["engineering", "growth", "support", "founder", "unassigned"]
        },
        "estimated_effort": {
          "type": "string",
          "enum": ["XS", "S", "M", "L", "XL"]
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blocking_reason": { "type": "string" },
        "requires_explicit_approval": {
          "type": "boolean",
          "description": "true si automation=AUTO_WITH_APPROVAL; l'application ne doit jamais muter le code sans ce champ validé par l'utilisateur"
        }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "repo": { "type": "string" },
    "sha": { "type": "string" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/item" }
    }
  }
}
